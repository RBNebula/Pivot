<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Pivot</AssemblyName>
    <RootNamespace>Pivot</RootNamespace>
    <ResourcesDir>Resources</ResourcesDir>
    <ResourcesImgDir>$(ResourcesDir)\Img</ResourcesImgDir>
    <ResourcesAudioDir>$(ResourcesDir)\Audio</ResourcesAudioDir>
    <ResourcesModelsDir>$(ResourcesDir)\Models</ResourcesModelsDir>
    <ResourcesPosesDir>$(ResourcesDir)\Poses</ResourcesPosesDir>
    <ResourcesShadersDir>$(ResourcesDir)\Shaders</ResourcesShadersDir>
    <ResourcesMaterialsDir>$(ResourcesDir)\Materials</ResourcesMaterialsDir>
    <ResourcesTexturesDir>$(ResourcesDir)\Textures</ResourcesTexturesDir>
    <ResourcesDataDir>$(ResourcesDir)\Data</ResourcesDataDir>
  </PropertyGroup>
  <PropertyGroup>
    <MineMogulDir Condition="'$(MineMogulDir)' == ''">F:\SteamLibrary\steamapps\common\MineMogul</MineMogulDir>
    <MineMogulManagedDir>$(MineMogulDir)\MineMogul_Data\Managed</MineMogulManagedDir>
    <MineMogulBepInExCoreDir>$(MineMogulDir)\BepInEx\core</MineMogulBepInExCoreDir>
    <MineMogulPluginsDir>$(MineMogulDir)\BepInEx\plugins</MineMogulPluginsDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(MineMogulBepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MineMogulBepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MineMogulManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MineMogulManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MineMogulManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(MineMogulManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MineMogulManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MineMogulManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(MineMogulManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(MineMogulManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tool Import API\ToolImportApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="$(ResourcesPosesDir)\*.arm-pose.cs" />
    <EmbeddedResource Include="$(ResourcesModelsDir)\screwdriver-world.glb">
      <LogicalName>Pivot.Resources.Models.screwdriver-world.glb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(ResourcesModelsDir)\screwdriver-view.glb">
      <LogicalName>Pivot.Resources.Models.screwdriver-view.glb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(ResourcesImgDir)\screwdriver-icon.png">
      <LogicalName>Pivot.Resources.Img.screwdriver-icon.png</LogicalName>
    </EmbeddedResource>
    <!-- Optional arm pose payloads: build still succeeds when no file exists. -->
    <EmbeddedResource Include="$(ResourcesPosesDir)\*.arm-pose.cs">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
